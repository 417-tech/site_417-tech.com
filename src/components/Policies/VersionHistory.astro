---
interface Props {
  policy: string;
  versions: Array<{ id: string; data: { version: string; date: string; current: boolean; summary?: string } }>;
  activeId: string; // the doc being viewed on this page — rendered as plain text, not a link
}
const { policy, versions, activeId } = Astro.props;
const fmt = (iso: string) =>
  new Date(iso).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
---
<div class="py-6 border-line mb-12">
  <span class="font-display font-bold text-[13px] tracking-caption uppercase text-primary block mb-4">Version history</span>
  <div class="overflow-x-auto">
    <table class="w-1/2 text-left border-collapse table-fixed">
      <colgroup>
        <col class="w-20" />
        <col class="w-28" />
        <col />
      </colgroup>
      <thead>
        <tr class="border-b-[1.5px] border-line">
          <th class="font-display font-bold text-caption tracking-caption uppercase text-muted pb-2 pr-6">Version</th>
          <th class="font-display font-bold text-caption tracking-caption uppercase text-muted pb-2 pr-6">Date</th>
          <th class="font-display font-bold text-caption tracking-caption uppercase text-muted pb-2">Summary</th>
        </tr>
      </thead>
      <tbody>
        {versions.map((v) => (
          <tr class="border-b border-line last:border-b-0">
            <td class="py-2.5 pr-6 align-top">
              {v.id === activeId ? (
                <span class="font-body font-semibold text-small text-(--accent)">{v.data.version}</span>
              ) : (
                <a class="font-body font-light text-small text-primary hover:text-(--accent) " href={`/legal/${policy}/${v.data.version}`}>{v.data.version}</a>
              )}
            </td>
            <td class="py-2.5 pr-6 align-top whitespace-nowrap font-body font-light text-small text-muted">{fmt(v.data.date)}</td>
            <td class="py-2.5 align-top font-body font-light text-small text-muted wrap-break-word">{v.data.summary ?? '—'}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</div>
