---
---
<form name="contact" method="POST" data-netlify="true" netlify-honeypot="bot-field" action="/contact/success" class="flex flex-col gap-5 max-w-110">
		<input type="hidden" name="form-name" value="contact" />
		<p class="hidden"><label>Leave this field empty if you're human: <input name="bot-field" /></label></p>
		<label class="flex flex-col gap-1.5">
			<span class="text-small text-secondary">Name</span>
			<input name="name" placeholder="Your name" required class="font-body text-body px-3.5 py-3 rounded-sm border-[1.5px] border-line bg-surface text-primary" />
		</label>
		<label class="flex flex-col gap-1.5">
			<span class="text-small text-secondary">Email</span>
			<input name="email" type="email" placeholder="you@company.com" required class="font-body text-body px-3.5 py-3 rounded-sm border-[1.5px] border-line bg-surface text-primary" />
		</label>
		<label class="flex flex-col gap-1.5">
			<span class="text-small text-secondary">Message</span>
			<textarea name="message" placeholder="What are you working on?" required class="font-body text-body px-3.5 py-3 rounded-sm border-[1.5px] border-line bg-surface text-primary min-h-30 resize-y"></textarea>
		</label>
		<div>
			<button type="submit" class="font-display font-bold text-[15px] tracking-caption uppercase text-primary bg-orchid-dark border-0 px-7 py-3.5 cursor-pointer rounded-sm">Send message</button>
		</div>
		<span class="text-caption text-muted">We'll get back to you as soon as we can.</span>
	</form>