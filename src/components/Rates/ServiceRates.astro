---
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);

---
{services.map((s) => (
  <div id={s.id} class="py-7 border-b-[1.5px] border-line scroll-mt-24 target:bg-surface">
    <div class="flex flex-col gap-1.5 md:grid md:grid-cols-[1fr_10rem_8rem] md:gap-5 md:items-center">
      <a class="font-body font-normal text-body text-primary hover:text-(--accent)" href={`/services/${s.id}`}>{s.data.title}</a>
      <span class="font-body font-light text-small md:text-body text-secondary">
        <span class="md:hidden text-muted">Rate — </span>{s.data.rate}
      </span>
      <a class="inline-flex items-center gap-1.5 font-display font-bold text-caption tracking-caption uppercase text-primary bg-orchid-dark px-3.5 py-2 rounded-sm hover:opacity-85 md:justify-self-start" href={`/contact?service=${encodeURIComponent(s.data.title)}`}>
        Enquire <Icon name="lucide:arrow-right" class="size-[1em]" />
      </a>
    </div>
    <div class="mt-4 flex flex-col gap-3 pl-5 border-l-[1.5px] border-line">
      {s.data.subsections.map((sub) => (
        <div class="flex flex-col gap-1 md:grid md:grid-cols-[1fr_10rem_8rem] md:gap-5 md:items-center">
          <span class="font-body font-light text-body text-secondary">{sub.title}</span>
          <span class="font-body font-light text-small text-muted">
            <span class="md:hidden">Rate — </span>{sub.rate}
          </span>
          <a class="inline-flex items-center justify-center size-7 rounded-sm text-muted hover:text-primary hover:bg-orchid-dark md:justify-self-start" href={`/contact?service=${encodeURIComponent(`${sub.title} (${s.data.title})`)}`} aria-label={`Enquire about ${sub.title}`}>
            <Icon name="lucide:arrow-right" class="size-[1em]" />
          </a>
        </div>
      ))}
    </div>
  </div>
))}