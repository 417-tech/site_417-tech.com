---
import { Icon } from 'astro-icon/components';
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" description="The page you're looking for doesn't exist.">
  <section class="pb-24 min-h-[50vh] flex flex-col justify-center">
    <div class="font-display font-normal text-small tracking-caption uppercase text-(--accent) mb-6">404 / Not found</div>
    <h1 class="font-display font-bold text-[clamp(40px,7vw,92px)] leading-tight tracking-display mb-8 max-w-[16ch]">This page doesn't exist.</h1>
    <p class="font-sub italic text-sub max-w-[64ch] text-secondary mb-14 leading-heading">The page you're looking for may have moved or never existed. Check the address, or head back to the homepage.</p>

    <a class="idx-link inline-flex items-center gap-3 self-start" href="/">
      <span class="font-display font-bold text-heading text-primary">Back to home</span>
      <Icon name="lucide:arrow-right" class="size-[1em] text-(--accent)" />
    </a>
  </section>
</Base>
