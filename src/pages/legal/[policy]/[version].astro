---
import Base from '../../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import VersionHistory from '../../../components/Policies/VersionHistory.astro';

// Stable, dated URL for every archived policy version — e.g. /legal/privacy/v0.9
export async function getStaticPaths() {
  const docs = await getCollection('legal');
  return docs.map((doc) => ({
    params: { policy: doc.data.policy, version: doc.data.version },
    props: {
      doc,
      versions: docs
        .filter((d) => d.data.policy === doc.data.policy)
        .sort((a, b) => Number(b.data.current) - Number(a.data.current) || b.data.date.localeCompare(a.data.date)),
    },
  }));
}
const { doc, versions } = Astro.props;
const d = doc.data;
const { Content } = await render(doc);
const fmt = (iso: string) =>
  new Date(iso).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
---
<Base
  title={`${d.title} ${d.version}`}
  description={d.current
    ? `Read 417 Tech's ${d.title} — current version ${d.version}, published ${fmt(d.date)}.`
    : `Archived copy of 417 Tech's ${d.title} ${d.version}, published ${fmt(d.date)}.`}
  canonical={new URL(`/legal/${d.policy}/`, Astro.site).href}
>
  <section class="pb-24">
    <div class="font-display font-normal text-small tracking-caption uppercase text-(--accent) mb-6">Legal / {d.label}</div>
    <h1 class="font-display font-bold text-[clamp(28px,4vw,44px)] leading-tight mb-3 max-w-[24ch]">{d.title}</h1>
    <div class="font-sub italic text-small text-muted mb-4">{d.version} — published {fmt(d.date)}{d.current ? ' (current)' : ' (archived)'}</div>
    <VersionHistory policy={d.policy} versions={versions} activeId={doc.id} />
    <div class="legal-prose max-w-[70ch]">
      <Content />
    </div>
  </section>
</Base>
