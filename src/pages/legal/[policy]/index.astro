---
import Base from '../../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { legalOrder } from '../../../data/site';
import ComingSoon from '../../../components/Policies/ComingSoon.astro';

export async function getStaticPaths() {
  const docs = await getCollection('legal');
  return legalOrder.map((policy) => {
    const versions = docs
      .filter((d) => d.data.policy === policy)
      .sort((a, b) => b.data.date.localeCompare(a.data.date));
    const current = versions.find((v) => v.data.current) ?? versions[0];
    return { params: { policy }, props: { current, versions } };
  });
}
const { current, versions } = Astro.props;
const d = current.data;
const { Content } = await render(current);
const fmt = (iso: string) =>
  new Date(iso).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
---
<Base title={d.title} description={`Read 417 Tech's ${d.title} — current version ${d.version}, published ${fmt(d.date)}.`}>
  <section class="pb-24">
    <div class="font-display font-normal text-small tracking-caption uppercase text-(--accent) mb-6">Legal / {d.label}</div>
    <h1 class="font-display font-bold text-[clamp(28px,4vw,44px)] leading-tight mb-3 max-w-[24ch]">{d.title}</h1>
    <div class="font-sub italic text-small text-muted mb-6">{d.version} — {fmt(d.date)}</div>

    <div class="flex gap-5 flex-wrap items-center py-4 border-y-[1.5px] border-line mb-12">
      <span class="font-display font-bold text-[13px] tracking-caption uppercase text-muted">Version history</span>
      {versions.map((v) => (
        v.id === current.id ? (
          <span class="font-body font-light text-small text-(--accent)">{v.data.version} · {fmt(v.data.date)} (current)</span>
        ) : (
          <a class="font-body font-light text-small text-muted underline" href={`/legal/${d.policy}/${v.data.version}`}>{v.data.version} · {fmt(v.data.date)}</a>
        )
      ))}
    </div>

    {d.comingSoon && (
      <ComingSoon />
    )}

    <div class="legal-prose max-w-[70ch]">
      <Content />
    </div>
  </section>
</Base>
